{
  "manifest_version": 3,
  "name": "BOSS 岗位收藏助手",
  "short_name": "BOSS Jobs",
  "version": "0.1.0",
  "description": "Save BOSS job postings into a sortable side panel for review and export.",
  "permissions": ["storage", "tabs", "scripting", "sidePanel"],
  "host_permissions": [
    "https://www.zhipin.com/*",
    "https://ark.cn-beijing.volces.com/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "BOSS 岗位收藏助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
